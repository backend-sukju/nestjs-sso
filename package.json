{
  "name": "nestjs-sso",
  "version": "0.1.0",
  "type": "module",
  "description": "NestJS + oidc-provider 기반 OIDC SSO 서버 목업 — 다중 클라이언트 · 토큰 교환(RFC 8693) 데모",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "npm run build && node dist/main.js",
    "start:dev": "nest start --watch",
    "apps": "node apps/run-all.js",
    "test:e2e": "node scripts/e2e.js",
    "test:multi": "node scripts/e2e-multi.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "cookie-parser": "^1.4.7",
    "jose": "^5.9.6",
    "oidc-provider": "^9.11.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
